# Resonance dev environment — copy to .env and adjust as needed.

# Postgres (metadata plane)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resonance
POSTGRES_USER=resonance
POSTGRES_PASSWORD=resonance

# ClickHouse (metrics plane)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=resonance

# Object store (audio/blob plane) — MinIO in dev
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=resonance
S3_SECRET_KEY=resonance-secret
S3_BUCKET=resonance-blobs

# Redpanda (stream queue)
KAFKA_BROKERS=localhost:9092
KAFKA_METRICS_TOPIC=metrics
# Event-driven audio derivation over Redpanda's HTTP proxy (pandaproxy). The API publishes a job on
# new-asset registration; workers consume and scale on consumer-group lag. The worker also polls
# Postgres as a correctness backstop, so this is best-effort.
PANDAPROXY_URL=http://localhost:8082
DERIVATION_TOPIC=audio.derivations
CONSUMER_GROUP=resonance-derivers

# Redis (cache)
REDIS_URL=redis://localhost:6379/0

# Storage lifecycle tiering — the worker periodically transitions audio assets hot -> ia -> archive
# by age since last activity (access warms them back to hot) and stamps a `resonance-tier` object tag
# so a real S3/GCS bucket lifecycle rule transitions the underlying storage class. Non-destructive:
# bytes are never deleted. Thresholds below are the platform default; a tenant can override via
# PUT /v1/orgs/{id}/lifecycle ({ia_days, archive_days}).
LIFECYCLE_ENABLED=true
LIFECYCLE_SWEEP_S=300
LIFECYCLE_IA_DAYS=30
LIFECYCLE_ARCHIVE_DAYS=90

# Media gateway (Go) — auth-scoped range streaming of originals behind a CDN. When MEDIA_PUBLIC_URL
# is set the API mints HMAC-signed URLs (MEDIA_SIGNING_SECRET must match the gateway) pointing at it;
# otherwise audio falls back to direct presigned object-store GETs.
MEDIA_PUBLIC_URL=http://localhost:8090
MEDIA_SIGNING_SECRET=resonance-dev-media-secret

# Service ports
INGEST_HTTP_PORT=8080
INGEST_GRPC_PORT=8081
API_PORT=8000
MEDIA_PORT=8090
